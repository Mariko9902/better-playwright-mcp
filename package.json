{
  "name": "better-playwright",
  "version": "3.2.0",
  "description": "Better Playwright - High-performance browser automation with intelligent content search",
  "main": "lib/index.js",
  "type": "module",
  "packageManager": "npm@10.9.2",
  "bin": {
    "better-playwright": "./bin/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check:tool-contract": "node ./scripts/check-tool-contract.mjs",
    "dev": "concurrently -k -r \"tsc -p tsconfig.json --watch --preserveWatchOutput\" \"node --watch ./lib/program.js\"",
    "smoke:batch": "node ./scripts/smoke-batch-fixture.mjs",
    "smoke:http-server": "node ./scripts/smoke-http-server.mjs",
    "smoke:live:add-customer": "node ./scripts/smoke-live-login-add-customer.mjs",
    "start": "node ./lib/program.js",
    "verify": "npm run build && npm run check:tool-contract && npm run smoke:batch && npm run smoke:http-server",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "playwright",
    "mcp",
    "model-context-protocol",
    "browser-automation"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.60.0",
    "@modelcontextprotocol/sdk": "^1.12.3",
    "@vscode/ripgrep": "^1.15.14",
    "commander": "^11.1.0",
    "debug": "^4.4.1",
    "dotenv": "^17.2.1",
    "express": "^4.18.2",
    "openai": "^5.15.0",
    "playwright": "^1.49.1",
    "uuid": "^9.0.1",
    "ws": "^8.18.3",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/debug": "^4.1.12",
    "@types/diff": "^5.0.8",
    "@types/domhandler": "^2.4.5",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "@types/uuid": "^9.0.7",
    "@types/ws": "^8.18.1",
    "concurrently": "^9.1.2",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
